# ==============================================================================
# SSCSTUDYPREPHUB (SSPH) - Environment Configuration
# Copy this file to `.env` for local development and fill in values as needed.
# NEVER commit `.env` or share secrets in client-side code.
# ==============================================================================

# 1. Database (Default: local SQLite with Prisma)
# For Supabase PostgreSQL (free tier), switch prisma/schema.prisma datasource
# to postgresql (see prisma/schema.postgresql.prisma) and use your pooler/direct URL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DATABASE_URL="file:./dev.db"

# 2. Application URL & SEO (used for canonicals, sitemap, GSC verification, signed callbacks)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# 3. Authentication & Signed Download Tokens (Required in production: 32+ random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-64-char-hex-random-secret-before-deployment"

# 4. Initial Admin Account Seed / Setup (Run `npm run admin:create`)
ADMIN_SEED_EMAIL="admin@sscstudyprephub.local"
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_NAME="SSPH Administrator"

# 5. Razorpay Payment Integration (Leave blank until Razorpay Test/Live keys are ready)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# 6. Rewarded-Ad & ShrinkMe.io Integration
# Modes: "unconfigured" | "server_callback" | "shrinkme" | "demo"
AD_PROVIDER_MODE="shrinkme"
AD_PROVIDER_NAME=""
AD_PROVIDER_WEBHOOK_SECRET=""
AD_PROVIDER_EMBED_URL=""
SHRINKME_API_TOKEN=""
ENABLE_DEMO_AD_UNLOCK="false"

# 7. Google Drive Auto-Sync Integration (Free Tier Google Cloud / Drive API v3)
# Folder ID from: https://drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=""
# Option A (Recommended - works with private folders shared with service account email):
# Paste full JSON string (single-line) or base64-encoded service account JSON
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Option B (For link-shared "Anyone with the link" folders):
GOOGLE_DRIVE_API_KEY=""
# Optional: Google Drive push notification channel secret & cron sync secret
GOOGLE_DRIVE_WEBHOOK_SECRET=""
CRON_SECRET=""
DRIVE_AUTO_PUBLISH="false"
# Optional (for instant Vercel -> GitHub Actions dispatch when Drive pushes webhook)
GITHUB_WORKFLOW_PAT=""
GITHUB_REPO=""

# 8. Optional Free-Tier Gemini API (Google AI Studio) for SEO Book Metadata Generation
# Model used: gemini-3.8-flash with Google Search grounding
GEMINI_API_KEY=""

# 9. Optional Supabase Free Tier (PostgreSQL / Auth / Protected PDF Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ssph-resources"

# 10. Optional Email Provider for Password Reset (Resend Free Tier)
RESEND_API_KEY=""
EMAIL_FROM="SSPH Support <support@sscstudyprephub.example>"
