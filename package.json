{
  "name": "sscstudyprephub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-prisma-schema.mjs && prisma generate && next build",
    "start": "next start",
    "postinstall": "node scripts/prepare-prisma-schema.mjs && prisma generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:use-postgres": "node -e \"require('fs').copyFileSync('prisma/schema.postgresql.prisma','prisma/schema.prisma')\"",
    "admin:create": "tsx scripts/create-admin.ts",
    "thumbnails:backfill": "tsx scripts/backfill-thumbnails.ts",
    "drive:sync": "tsx scripts/drive-sync-worker.ts",
    "test": "tsx --test tests/core.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^3.1.0",
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.71.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
